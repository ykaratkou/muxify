#!/bin/sh
# Muxify command line tool.
#
#   muxify browser open [--window <id>] <url>...
#   muxify session open <session name>
#   muxify extensions install
#
# browser open: opens each URL as a Tab in the Browser of the tmux Window this
# runs in. It targets $TMUX_PANE, not the session's current Window, so callers
# without a tty (agents, background jobs) still hit their own Window. Muxify
# picks the request up from the Window's @muxify_open option within a second
# (ADR 0003).
#
# session open: brings Muxify to the front (launching it if needed) showing
# that tmux Session's current Window. Works from anywhere, inside tmux or not.
set -eu

usage() {
    cat >&2 <<'EOF'
usage: muxify browser open [--window <id>] <url>...
       muxify session open <session name>
       muxify extensions install

browser open   Opens each URL as a Tab in this tmux Window's Browser.
                 --window <id>   open in another Window instead, e.g. --window @12
session open   Shows the tmux Session in Muxify. The name may contain spaces,
               quoted or not: muxify session open my project
extensions install
               Installs or updates Extensions for Agents configured under HOME.
EOF
    exit "${1:-2}"
}

die() {
    echo "muxify: $*" >&2
    exit 1
}

browser_open() {
    target=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -w|--window)
                [ $# -ge 2 ] || usage
                target="$2"
                shift 2
                ;;
            --window=*)
                target="${1#--window=}"
                shift
                ;;
            -h|--help) usage 0 ;;
            --) shift; break ;;
            -*) die "unknown option $1" ;;
            *) break ;;
        esac
    done
    [ $# -gt 0 ] || usage

    if [ -z "$target" ]; then
        [ -n "${TMUX_PANE:-}" ] || die "not inside tmux; specify the Window with --window <id> (e.g. --window @12)"
        target="$TMUX_PANE"
    fi

    urls=""
    for url in "$@"; do
        case "$url" in
            *[[:space:]]*) die "'$url' contains spaces; pass one URL per argument" ;;
        esac
        urls="$urls $url"
    done

    # Not display-message: it exits 0 for a target that doesn't exist.
    window=$(tmux list-panes -t "$target" -F '#{window_id}' 2>/dev/null | head -n 1)
    [ -n "$window" ] || die "no tmux Window '$target'"
    # Append, so requests made before Muxify's next poll aren't overwritten.
    tmux set-option -wa -t "$window" @muxify_open "$urls"
}

# Percent-encodes every byte, which any URL parser decodes back.
urlencode() {
    printf '%s' "$1" | od -An -tx1 -v | tr -d ' \n' | sed 's/../%&/g'
}

session_open() {
    case "${1:-}" in
        -h|--help) usage 0 ;;
        --) shift ;;
    esac
    [ $# -gt 0 ] || usage
    # The words make up one name, so it needs no quoting.
    name="$*"
    tmux has-session -t "=$name" 2>/dev/null || die "no tmux session '$name'"
    open "muxify://select?session=$(urlencode "$name")"
}

extensions_install() {
    case "${1:-}" in -h|--help) usage 0 ;; esac
    [ $# -eq 0 ] || die "extensions install takes no arguments"
    # The installed command is a symlink into the app bundle. Resolve that
    # link (including relative links) before looking for sibling resources.
    tool=$0
    case "$tool" in /*) ;; *) tool="$(pwd)/$tool" ;; esac
    links=0
    while [ -L "$tool" ]; do
        links=$((links + 1))
        [ "$links" -le 40 ] || die "command line tool has a symlink loop"
        dir=$(CDPATH= cd -P -- "$(dirname -- "$tool")" && pwd) || die "cannot locate command line tool"
        link=$(readlink "$tool") || die "cannot read command line tool symlink"
        case "$link" in /*) tool=$link ;; *) tool="$dir/$link" ;; esac
    done
    dir=$(CDPATH= cd -P -- "$(dirname -- "$tool")" && pwd) || die "cannot locate command line tool"
    installer="$dir/../extensions/install.sh"
    [ -r "$installer" ] || die "Extension installer is missing beside the command line tool"
    exec /bin/sh "$installer"
}

case "${1:-}" in
    extensions)
        shift
        case "${1:-}" in
            install) shift; extensions_install "$@" ;;
            -h|--help) usage 0 ;;
            *) usage ;;
        esac
        ;;
    session)
        shift
        case "${1:-}" in
            open) shift; session_open "$@" ;;
            -h|--help) usage 0 ;;
            *) usage ;;
        esac
        ;;
    browser)
        shift
        case "${1:-}" in
            open) shift; browser_open "$@" ;;
            -h|--help) usage 0 ;;
            *) usage ;;
        esac
        ;;
    -h|--help|help) usage 0 ;;
    *) usage ;;
esac
